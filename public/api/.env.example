# A2ZSMS lead-proxy secrets.
# ------------------------------------------------------------------
# On the Hostinger server: copy this file to `.env` (same directory)
# and paste the real values you have in your team's password vault.
# `.env` is blocked from public access by the sibling .htaccess and
# is git-ignored in this repo.
# ------------------------------------------------------------------

TELECRM_TOKEN    = "PASTE_TELECRM_BEARER_TOKEN"
TELECRM_API      = "PASTE_TELECRM_AUTOUPDATELEAD_URL"

AISENSY_API_KEY  = "PASTE_AISENSY_JWT"
AISENSY_URL      = "PASTE_AISENSY_CAMPAIGN_V2_URL"
AISENSY_CAMPAIGN = "ojiva_lead_welcome"

MAKE_WEBHOOK     = "PASTE_MAKE_COM_WEBHOOK_URL"

WEB3FORMS_URL    = "https://api.web3forms.com/submit"
WEB3FORMS_KEY    = "PASTE_WEB3FORMS_ACCESS_KEY"
