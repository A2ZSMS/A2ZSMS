# Block direct access to any .env / log / config file (defence in depth)
<FilesMatch "^\.env|\.(env|log|ini|conf)(\..+)?$">
  Require all denied
</FilesMatch>

# Belt-and-suspenders — also block .env.example, .env.local, etc.
<Files ".env*">
  Require all denied
</Files>

# Prevent directory listing
Options -Indexes

# Only allow POST + OPTIONS on lead.php (browsers preflight requests)
<Files "lead.php">
  <LimitExcept POST OPTIONS>
    Require all denied
  </LimitExcept>
</Files>
