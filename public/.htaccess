# A2ZSMS – copied into out/ on every `npm run build`.
# If cPanel ever adds a "php -- BEGIN cPanel-generated handler" block to the
# live .htaccess, copy that block into this file too, or the next upload will remove it.

Options -MultiViews
DirectoryIndex index.html index.php

RewriteEngine On

# 1) Remove the confirmed junk homepage query patterns found in Search Console.
# Keep legitimate campaign parameters (utm_*, gclid, fbclid, etc.) untouched.
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{QUERY_STRING} ^(?:m=[A-Za-z0-9]{12,}|[A-Za-z-]+/[0-9]{8,})$ [NC]
# The trailing "?" drops the query string (works on Apache and all LiteSpeed versions)
RewriteRule ^$ https://www.a2zsms.in/? [R=301,L]

# 2) One single redirect to https://www (no http/non-www chains)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.a2zsms\.in$ [NC]
RewriteRule ^(.*)$ https://www.a2zsms.in/$1 [R=301,L]

# 3) Leave real files (forms API, images, sitemap, etc.) alone
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^api/ - [L]

# 4) Retired / duplicate URLs
RewriteRule ^home/?$ https://www.a2zsms.in/ [R=301,L]
RewriteRule ^refund-policie/?$ https://www.a2zsms.in/refund-policy/ [R=301,L]

# 5) Add the trailing slash for pages that exist (site uses /page/ URLs)
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ https://www.a2zsms.in/$1/ [R=301,L]

# 6) Real 404 for pages that do not exist
ErrorDocument 404 /404.html

# 7) Speed: compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 8) Speed: browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Pages and data must always be fresh after a new upload
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
